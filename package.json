{
  "name": "dsh-mindmap",
  "version": "1.0.0",
  "type": "module",
  "description": "XMind-style mind maps inside the DSH web GUI: read and edit Markdown mind maps from the conversation, open .xmind files, and write changes back to the Markdown note.",
  "license": "MIT",
  "author": "TheycallmeXH",
  "homepage": "https://github.com/TheycallmeXH/dsh-mindmap#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheycallmeXH/dsh-mindmap.git"
  },
  "bugs": {
    "url": "https://github.com/TheycallmeXH/dsh-mindmap/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "mindmap",
    "xmind",
    "markdown",
    "sidebar-right"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
